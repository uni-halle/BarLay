#pragma once
#include <cstdint>

// Base params
#define ROW_COUNT @ROW_COUNT@
#define COL_COUNT @COL_COUNT@
#define NUMBER_OF_SCHEDULES @NUMBER_OF_SCHEDULES@
#define SCHEDULE_LENGTH (@SCHEDULE_LENGTH@)

// Chunk math (ceil-div): ((L + B - 1) / B)
#define SYNTH_SCHEDULE_CHUNK_BIT_SIZE (8*sizeof(uint32_t))
#define SYNTH_SCHEDULE_CHUNKS ((SCHEDULE_LENGTH + SYNTH_SCHEDULE_CHUNK_BIT_SIZE - 1) / SYNTH_SCHEDULE_CHUNK_BIT_SIZE)